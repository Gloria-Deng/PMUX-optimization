[options]

[gold]
read_verilog -sv "../../../cases/test3.v"
hierarchy -check -top test3
proc
setundef -undriven -zero
setundef -init -zero
prep -top test3 -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top test3
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "../test3/delivered/postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top test3 -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top test3
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect test3]
group *
bind *

[strategy whole]
use sat
depth 12
