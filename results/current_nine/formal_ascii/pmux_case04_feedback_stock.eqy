[options]

[gold]
read_verilog -sv "../../../cases/pmux_case04_feedback.v"
hierarchy -check -top pmux_case04_feedback
proc
setundef -undriven -zero
setundef -init -zero
prep -top pmux_case04_feedback -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top pmux_case04_feedback
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "../pmux_case04_feedback/stock/postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top pmux_case04_feedback -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top pmux_case04_feedback
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect pmux_case04_feedback]
group *
bind *

[strategy whole]
use sat
depth 12
