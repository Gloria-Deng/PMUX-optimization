plugin -i E:\Yosys\oss-cad-suite\oss-cad-suite\bin/../share/yosys/plugins/eqy_combine.so
read_rtlil pmux_case01_balanced_delivered/gold.il
uniquify
hierarchy
design -stash gold
read_rtlil pmux_case01_balanced_delivered/gate_recoded.il
uniquify
hierarchy
design -stash gate
eqy_combine -gold_ids pmux_case01_balanced_delivered/gold.ids -gate_ids pmux_case01_balanced_delivered/gate_recoded.ids
write_rtlil pmux_case01_balanced_delivered/combined.il
