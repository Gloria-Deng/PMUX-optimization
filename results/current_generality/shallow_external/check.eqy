[options]

[gold]
read_verilog -sv "../../../scripts/generality_cases/shallow_external.v"
hierarchy -check -top shallow_external
proc
setundef -undriven -zero
setundef -init -zero
rename -hide
prep -top shallow_external -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top shallow_external
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "after.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
rename -hide
prep -top shallow_external -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top shallow_external
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect shallow_external]
group *
bind *

[strategy whole]
use sat
depth 12
