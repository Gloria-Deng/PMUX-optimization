    parameter \WIDTH 17
    parameter \CLK_POLARITY 1'1
    connect \CLK \clk
    connect \D $0\lane[0].q[16:0]
    connect \Q \data_out
  end
  connect { \rst \en \data_in \ctrl_in \clk } { \__pi_rst \__pi_en \__pi_data_in \__pi_ctrl_in \__pi_clk }
  connect \__po_data_out \data_out
end
