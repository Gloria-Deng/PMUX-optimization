[options]

[gold]
read_verilog -sv "../../../scripts/algorithm_cases/variant_partial_result.v"
hierarchy -check -top variant_partial_result
proc
setundef -undriven -zero
setundef -init -zero
prep -top variant_partial_result -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_partial_result
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top variant_partial_result -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_partial_result
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect variant_partial_result]
group *
bind *

[strategy whole]
use sat
depth 12
