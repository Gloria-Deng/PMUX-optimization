[options]

[gold]
read_verilog -sv "../../../scripts/algorithm_cases/variant_lanes2.v"
hierarchy -check -top variant_lanes2
proc
setundef -undriven -zero
setundef -init -zero
prep -top variant_lanes2 -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_lanes2
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top variant_lanes2 -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_lanes2
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect variant_lanes2]
group *
bind *

[strategy whole]
use sat
depth 12
