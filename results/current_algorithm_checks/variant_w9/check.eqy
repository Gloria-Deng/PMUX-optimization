[options]

[gold]
read_verilog -sv "../../../scripts/algorithm_cases/variant_w9.v"
hierarchy -check -top variant_w9
proc
setundef -undriven -zero
setundef -init -zero
prep -top variant_w9 -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_w9
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top variant_w9 -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_w9
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect variant_w9]
group *
bind *

[strategy whole]
use sat
depth 12
