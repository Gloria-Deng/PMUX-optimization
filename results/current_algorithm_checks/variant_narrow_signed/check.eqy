[options]

[gold]
read_verilog -sv "../../../scripts/algorithm_cases/variant_narrow_signed.v"
hierarchy -check -top variant_narrow_signed
proc
setundef -undriven -zero
setundef -init -zero
prep -top variant_narrow_signed -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_narrow_signed
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top variant_narrow_signed -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_narrow_signed
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect variant_narrow_signed]
group *
bind *

[strategy whole]
use sat
depth 12
