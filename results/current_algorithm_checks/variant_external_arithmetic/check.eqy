[options]

[gold]
read_verilog -sv "../../../scripts/algorithm_cases/variant_external_arithmetic.v"
hierarchy -check -top variant_external_arithmetic
proc
setundef -undriven -zero
setundef -init -zero
prep -top variant_external_arithmetic -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_external_arithmetic
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../plugin/dffeas_formal.v"
prep -top variant_external_arithmetic -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top variant_external_arithmetic
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect variant_external_arithmetic]
group *
bind *

[strategy whole]
use sat
depth 12
