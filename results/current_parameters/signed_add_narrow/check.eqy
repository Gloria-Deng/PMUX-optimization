[options]

[gold]
read_verilog -sv "../source.v"
hierarchy -check -top signed_add_narrow
proc
setundef -undriven -zero
setundef -init -zero
prep -top signed_add_narrow -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top signed_add_narrow
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../../plugin/dffeas_formal.v"
prep -top signed_add_narrow -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top signed_add_narrow
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect signed_add_narrow]
group *
bind *

[strategy whole]
use sat
depth 12
