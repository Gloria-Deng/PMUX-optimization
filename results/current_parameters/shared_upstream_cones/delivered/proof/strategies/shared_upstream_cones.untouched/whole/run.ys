verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../partitions/shared_upstream_cones.untouched.sv
read_rtlil ../../../partitions/shared_upstream_cones.untouched.il
hierarchy -top miter; proc; chformal -cover -remove
async2sync
formalff -clk2ff -ff2anyinit gate.shared_upstream_cones.untouched
setundef -anyseq gate.shared_upstream_cones.untouched
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
sat -tempinduct -set-init-undef -set-def-formal -set-def-inputs -maxsteps 12 -set-assumes -prove-asserts -show-public -dump_vcd trace.vcd miter
