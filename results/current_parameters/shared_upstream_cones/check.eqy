[options]

[gold]
read_verilog -sv "../source.v"
hierarchy -check -top shared_upstream_cones
proc
setundef -undriven -zero
setundef -init -zero
prep -top shared_upstream_cones -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top shared_upstream_cones
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../../plugin/dffeas_formal.v"
prep -top shared_upstream_cones -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top shared_upstream_cones
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect shared_upstream_cones]
group *
bind *

[strategy whole]
use sat
depth 12
