chparam -set WIDTH 4 -set LANES 2 pmux_case05_nested;
hierarchy -check -top pmux_case05_nested
proc
setundef -undriven -zero
setundef -init -zero
prep -top pmux_case05_nested -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top pmux_case05_nested
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../../plugin/dffeas_formal.v"
prep -top pmux_case05_nested -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top pmux_case05_nested
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect pmux_case05_nested]
group *
bind *

[strategy whole]
