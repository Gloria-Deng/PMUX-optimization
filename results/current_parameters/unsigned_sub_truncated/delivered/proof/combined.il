    connect \A $auto$miter.cc:197:create_miter_equiv$1071
    connect \B $auto$miter.cc:198:create_miter_equiv$1072
    connect \Y $auto$miter.cc:228:create_miter_equiv$1076
  end
  cell $assert $auto$miter.cc:273:create_miter_equiv$1077
    connect \A $auto$miter.cc:228:create_miter_equiv$1076
    connect \EN 1'1
  end
  cell $not $auto$miter.cc:281:create_miter_equiv$1078
    parameter \A_WIDTH 1
    parameter \Y_WIDTH 1
    parameter \A_SIGNED 0
    connect \A $auto$miter.cc:228:create_miter_equiv$1076
    connect \Y \trigger
  end
end
