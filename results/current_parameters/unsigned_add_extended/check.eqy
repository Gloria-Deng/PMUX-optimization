[options]

[gold]
read_verilog -sv "../source.v"
hierarchy -check -top unsigned_add_extended
proc
setundef -undriven -zero
setundef -init -zero
prep -top unsigned_add_extended -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top unsigned_add_extended
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../../plugin/dffeas_formal.v"
prep -top unsigned_add_extended -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top unsigned_add_extended
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect unsigned_add_extended]
group *
bind *

[strategy whole]
use sat
depth 12
