[options]

[gold]
read_verilog -sv "../source.v"
hierarchy -check -top dependent_selections
proc
setundef -undriven -zero
setundef -init -zero
prep -top dependent_selections -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top dependent_selections
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[gate]
read_rtlil "postabc.il"
read_verilog -overwrite "../../../../plugin/dffeas_formal.v"
prep -top dependent_selections -flatten
setundef -undriven -zero
setundef -init -zero
hierarchy -purge_lib -top dependent_selections
memory_map
async2sync
setundef -undriven -zero
setundef -init -zero

[collect dependent_selections]
group *
bind *

[strategy whole]
use sat
depth 12
